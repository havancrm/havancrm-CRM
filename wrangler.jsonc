{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crm",
  "main": "src/server/index.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SPREADSHEET_ID": "1KbM5G_-O24NfRfiAX9eBcp9KBg_GjGXd7aUCKVdfkHY",
    "DATA_MODE": "sheets",
    "AUTH_MODE": "google",
    "GOOGLE_CLIENT_ID": ""
  }
}
